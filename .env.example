# Copy this file to .env and fill in your Firebase project's values.
# Get these from: Firebase Console -> Project Settings -> General -> "Your apps" -> Web app config
#
# If these are left blank, VieWard automatically runs in DEMO SIMULATION
# mode with fake patients and live-looking fake vitals, so the app is
# still fully explorable with zero setup.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# How many bedside units this ward has (default 8).
VITE_BED_COUNT=8
